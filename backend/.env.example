# Copy this file to .env and adjust as needed.
# See README.md for detailed configuration information

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_ORIGIN=http://localhost:3000

# ============================================
# VIDEO UPLOAD CONSTRAINTS
# ============================================
MAX_UPLOAD_SIZE_MB=500
MAX_FRAMES_TO_ANALYZE=16  # Safe batch size for AI processing

# ============================================
# AUDIO TRANSCRIPTION (Whisper)
# ============================================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ============================================
# AI/VISION MODEL CONFIGURATION (AICredits)
# ============================================
# Replace with your actual AICredits API key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_API_KEY=sk-live-YOUR_API_KEY_HERE
AICREDITS_TIMEOUT_SECONDS=120.0
AICREDITS_MAX_RETRIES=2

# AI Model Selection (cost-optimized)
VISION_MODEL=google/gemma-3-4b-it
SOP_MODEL=inclusionai/ling-2.6-flash

# ============================================
# PERFORMANCE TUNING
# ============================================
VISION_IMAGE_MAX_DIM=384
MAX_CONCURRENT_VISION_WORKERS=3

# ============================================
# OCR CONFIGURATION (EasyOCR)
# ============================================
# Set to 'true' to enable OCR with EasyOCR
# Set to 'false' to disable OCR (app still works without it)
OCR_ENABLED=true

# ============================================
# ELASTICSEARCH CONFIGURATION (Optional)
# ============================================
# For indexing and searching SOP documents
# Leave blank to disable (app will work without it)

# Elasticsearch Connection URL
# Local Docker: http://localhost:9200
# Cloud (Elastic): https://your-cluster.es.us-central1.gcp.cloud.es.io:9243
ELASTICSEARCH_URL=http://localhost:9200

# API Key for authentication (optional)
# Only needed if Elasticsearch has security enabled
ELASTICSEARCH_API_KEY=

# Index name where SOPs will be stored
ELASTICSEARCH_SOP_INDEX=sops

# Note: If Elasticsearch is not available, SOPs will still be saved locally
# (graceful degradation - warning will be logged)
